@model Producto
@{
    ViewData["Title"] = "Detalle del producto";
}

<h1 class="h3 mb-3">Detalle del producto</h1>

<div class="card shadow-sm" style="max-width: 640px;">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-5">Nombre</dt>
            <dd class="col-sm-7">@Model.Nombre</dd>

            <dt class="col-sm-5">Categoría</dt>
            <dd class="col-sm-7">@Model.Categoria?.Nombre</dd>

            <dt class="col-sm-5">Precio</dt>
            <dd class="col-sm-7">@Model.Precio</dd>

            <dt class="col-sm-5">Stock</dt>
            <dd class="col-sm-7">@Model.Stock unidades</dd>

            <dt class="col-sm-5">Fecha de vencimiento</dt>
            <dd class="col-sm-7">@(Model.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "No aplica")</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-marca">Editar</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a>
</div>
