@model IEnumerable<Producto>
@{
    ViewData["Title"] = "Productos";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Productos</h1>
    <a asp-action="Create" class="btn btn-marca"><i class="bi bi-plus-lg"></i> Nuevo producto</a>
</div>

<form asp-action="Index" method="get" class="input-group mb-3" style="max-width: 420px;">
    <input type="text" name="texto" value="@ViewBag.Buscar" class="form-control" placeholder="Buscar por nombre..." />
    <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
</form>

<table class="table table-hover align-middle bg-white shadow-sm">
    <thead class="table-light">
        <tr>
            <th>Nombre</th>
            <th>Categoría</th>
            <th class="text-end">Precio</th>
            <th class="text-end">Stock</th>
            <th>Vencimiento</th>
            <th>Estado</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre</td>
                <td>@item.Categoria?.Nombre</td>
                <td class="text-end">S/ @item.Precio.ToString("N2")</td>
                <td class="text-end">@item.Stock</td>
                <td>@(item.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "—")</td>
                <td>
                    @if (item.Stock > 5)
                    {
                        <span class="badge text-bg-success">Disponible</span>
                    }
                    else if (item.Stock >= 0)
                    {
                        <span class="badge text-bg-warning">Stock bajo</span>
                    }
                    else
                    {
                        <span class="badge text-bg-danger">Agotado</span>
                    }
                </td>
                <td class="text-end text-nowrap">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Ver"><i class="bi bi-eye"></i></a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Editar"><i class="bi bi-pencil"></i></a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">No se encontraron productos.</p>
}
